# Copia a ibkr-bridge.env junto al script. Este archivo de ejemplo no contiene secretos.
MISSION_CONTROL_URL=https://cesar-solla.pages.dev
TRADING_BRIDGE_TOKEN=
IBKR_BASE_URL=https://localhost:5000/v1/api
# Exporta el certificado de confianza del Gateway local en formato PEM.
IBKR_CA_CERT=C:/ruta/al/certificado-local.pem
